PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Google AI Studio Gemini API. OpenAI-compatible hosted Gemma endpoints
# are still supported if GEMMA_API_URL points at an OpenAI-compatible URL.
GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_API_KEY=replace-with-your-provider-token
GEMMA_MODEL=gemini-flash-latest
